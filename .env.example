# ════════════════════════════════════════════════════════════════
#  ProvenMesh — Environment Configuration Template
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
APP_ENV=development   # development | production

# ─── Infrastructure (Docker Compose provides these automatically) ─
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://provenmesh:provenmesh_dev@localhost:5432/provenmesh
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=provenmesh-raw
S3_ACCESS_KEY=provenmesh
S3_SECRET_KEY=provenmesh_dev
S3_REGION=us-east-1

# ─── LLM Providers (all FREE — get keys below) ───────────────────
#
#  1. Gemini 2.5 Flash — https://aistudio.google.com/app/apikey
#     Free: 15 req/min, no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here
#
#  2. Groq — https://console.groq.com/keys
#     Free: 14,400 req/day, Llama 3.3 70B
GROQ_API_KEY=your_groq_api_key_here
#
#  3. OpenRouter — https://openrouter.ai/keys
#     Free: Nemotron 120B, Gemma 4 31B (no billing required)
OPENROUTER_API_KEY=your_openrouter_api_key_here
#
#  4. DeepSeek (optional paid fallback) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─── GitHub (optional — enriches paper data with GitHub stars) ───
#  Get at: https://github.com/settings/tokens (public_repo scope)
GITHUB_TOKEN=your_github_pat_here

# ─── Google Sheets Export ────────────────────────────────────────
#  1. Create a Google Cloud project
#  2. Enable Sheets API
#  3. Create Service Account → download JSON → save to configs/
#  4. Share your spreadsheet with the service account email
GOOGLE_SHEETS_CREDENTIALS_JSON=configs/google_service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# ─── LLM Cost Governance ─────────────────────────────────────────
LLM_DAILY_TOKEN_BUDGET=5000000
LLM_WARNING_THRESHOLD_PCT=80
LLM_HALT_THRESHOLD_PCT=100
LLM_CACHE_TTL_SECONDS=86400

# ─── Crawling ────────────────────────────────────────────────────
PER_DOMAIN_RATE_LIMIT_RPS=1
MAX_DOMAIN_CONCURRENCY=5
MAX_GLOBAL_CONCURRENCY=50
MAX_FETCH_RETRIES=5
FETCH_TIMEOUT_SECONDS=30

# ─── Entity Resolution ───────────────────────────────────────────
GROUNDING_THRESHOLD=90
FUZZY_THRESHOLD=85
EMBEDDING_ACCEPT_THRESHOLD=0.88
REVIEW_THRESHOLD=0.75

# ─── Deduplication ───────────────────────────────────────────────
DEDUP_TTL_SECONDS=2592000

# ─── Workers ─────────────────────────────────────────────────────
WORKER_MAX_ITEMS_BEFORE_RECYCLE=1000
WORKER_HEALTH_CHECK_PORT=8080

# ─── Backpressure ────────────────────────────────────────────────
QUEUE_HIGH_WATER_MARK=10000
QUEUE_LOW_WATER_MARK=5000
BACKPRESSURE_MAX_DELAY_SECONDS=30

# ─── Circuit Breaker ─────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30


# ─── Infrastructure ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://provenmesh:provenmesh_dev@localhost:5432/provenmesh
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=provenmesh-raw
S3_ACCESS_KEY=provenmesh
S3_SECRET_KEY=provenmesh_dev
S3_REGION=us-east-1

# ─── LLM Providers ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ─── GitHub (for paper enrichment) ───────────────────────────────
GITHUB_TOKEN=your_github_pat_here

# ─── Proxy Pool (Tier 3 only) ───────────────────────────────────
PROXY_POOL_URL=http://user:pass@proxy-provider:port

# ─── Google Sheets Export ────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS_JSON=path/to/service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# ─── LLM Cost Governance ────────────────────────────────────────
LLM_DAILY_TOKEN_BUDGET=5000000
LLM_WARNING_THRESHOLD_PCT=80
LLM_HALT_THRESHOLD_PCT=100
LLM_CACHE_TTL_SECONDS=86400

# ─── Crawling ───────────────────────────────────────────────────
PER_DOMAIN_RATE_LIMIT_RPS=1
MAX_DOMAIN_CONCURRENCY=5
MAX_GLOBAL_CONCURRENCY=50
MAX_FETCH_RETRIES=5
FETCH_TIMEOUT_SECONDS=30

# ─── Entity Resolution ──────────────────────────────────────────
GROUNDING_THRESHOLD=90
FUZZY_THRESHOLD=85
EMBEDDING_ACCEPT_THRESHOLD=0.88
REVIEW_THRESHOLD=0.75

# ─── Deduplication ──────────────────────────────────────────────
DEDUP_TTL_SECONDS=2592000

# ─── Workers ────────────────────────────────────────────────────
WORKER_MAX_ITEMS_BEFORE_RECYCLE=1000
WORKER_HEALTH_CHECK_PORT=8080

# ─── Backpressure ───────────────────────────────────────────────
QUEUE_HIGH_WATER_MARK=10000
QUEUE_LOW_WATER_MARK=5000
BACKPRESSURE_MAX_DELAY_SECONDS=30

# ─── Circuit Breaker ────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60
