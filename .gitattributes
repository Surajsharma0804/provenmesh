# Auto detect and normalize line endings
* text=auto

# Force LF for all source files
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.mako text eol=lf

# Force CRLF for Windows-specific files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — do not touch
*.pdf binary
*.png binary
*.jpg binary
*.gif binary
