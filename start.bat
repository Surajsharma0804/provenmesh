@echo off
title ProvenMesh Pipeline
color 0B
echo.
echo  ??????? ???????  ??????? ???   ???????????????   ???????   ???????????????????????  ???
echo  ????????????????????????????   ????????????????  ???????? ????????????????????????  ???
echo  ???????????????????   ??????   ?????????  ?????? ????????????????????  ????????????????
echo  ??????? ???????????   ??????? ??????????  ???????????????????????????  ????????????????
echo  ???     ???  ???????????? ??????? ??????????? ????????? ??? ??????????????????????  ???
echo  ???     ???  ??? ???????   ?????  ???????????  ????????     ??????????????????????  ???
echo.
echo  AI Ecosystem Intelligence Pipeline
echo  ====================================
echo.

echo [1/3] Starting Docker infrastructure (Postgres + Redis + MinIO)...
docker compose up -d
if %errorlevel% neq 0 (
    echo ERROR: Docker failed. Is Docker Desktop running?
    pause
    exit /b 1
)
echo  OK - Infrastructure running
echo.

echo [2/3] Waiting for services to be ready...
timeout /t 5 /nobreak > nul
echo  OK - Services ready
echo.

echo [3/3] Starting ProvenMesh pipeline...
echo  - Crawl workers:   3
echo  - Extract workers: 2  (Gemini ? Groq ? Nemotron 120B ? Gemma 31B)
echo  - Resolve workers: 2
echo  - Auto-export:     Every 20 minutes to Google Sheets
echo.
echo  Google Sheet: https://docs.google.com/spreadsheets/d/130p3Bo5gZRBHWt9tK8J8BqVP5YY2ckaoCWW1UeC7vEc
echo.
echo  Press Ctrl+C to stop the pipeline
echo.

.venv\Scripts\python.exe -m provenmesh.main run ^
  --crawl-workers 3 ^
  --extract-workers 2 ^
  --resolve-workers 2 ^
  --auto-export ^
  --export-interval 20

pause
